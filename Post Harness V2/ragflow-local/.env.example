RAGFLOW_IMAGE=infiniflow/ragflow:v0.27.3
RAGFLOW_PLATFORM=linux/amd64
DOC_ENGINE=elasticsearch
API_PROXY_SCHEME=python
DEVICE=cpu
DB_TYPE=mysql
MACOS=1
TZ=America/Argentina/Buenos_Aires
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DBNAME=rag_flow
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
ES_HOST=es01
ELASTIC_PASSWORD=CHANGE_ME_ELASTIC_PASSWORD
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_USER=qa_local
MINIO_PASSWORD=CHANGE_ME_MINIO_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
TEI_HOST=host.docker.internal
USE_DOCLING=false
REGISTER_ENABLED=1
ENABLE_REGISTER=1
THREAD_POOL_MAX_WORKERS=4
MAX_CONCURRENT_TASKS=1
DOC_BULK_SIZE=1
EMBEDDING_BATCH_SIZE=4
SVR_WEB_HTTP_PORT=8088
SVR_HTTP_PORT=9388
