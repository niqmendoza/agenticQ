{
  "name": "qa-ragflow-local",
  "services": {
    "es01": {
      "image": "elasticsearch:8.11.3",
      "environment": {
        "node.name": "es01",
        "discovery.type": "single-node",
        "xpack.security.enabled": "true",
        "xpack.security.http.ssl.enabled": "false",
        "xpack.security.transport.ssl.enabled": "false",
        "ELASTIC_PASSWORD": "${ELASTIC_PASSWORD}",
        "ES_JAVA_OPTS": "-Xms512m -Xmx512m",
        "cluster.routing.allocation.disk.watermark.low": "3gb",
        "cluster.routing.allocation.disk.watermark.high": "2gb",
        "cluster.routing.allocation.disk.watermark.flood_stage": "1gb"
      },
      "volumes": [
        "esdata:/usr/share/elasticsearch/data"
      ],
      "mem_limit": "1536m",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl -fsS -u elastic:$$ELASTIC_PASSWORD http://localhost:9200/_cluster/health >/dev/null"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 30,
        "start_period": "20s"
      },
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "mysql": {
      "image": "mysql:8.0.40",
      "environment": {
        "MYSQL_ROOT_PASSWORD": "${MYSQL_PASSWORD}"
      },
      "command": [
        "--character-set-server=utf8mb4",
        "--collation-server=utf8mb4_unicode_ci",
        "--default-authentication-plugin=mysql_native_password",
        "--max-connections=100",
        "--max-allowed-packet=1073741824",
        "--innodb-buffer-pool-size=128M",
        "--innodb-redo-log-capacity=128M",
        "--init-file=/data/application/init.sql"
      ],
      "volumes": [
        "mysqldata:/var/lib/mysql",
        "./upstream/init.sql:/data/application/init.sql:ro"
      ],
      "mem_limit": "640m",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "MYSQL_PWD=$$MYSQL_ROOT_PASSWORD mysqladmin ping -h 127.0.0.1 -uroot --silent"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 30,
        "start_period": "20s"
      },
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "minio": {
      "image": "pgsty/silo:RELEASE.2026-08-06T00-00-00Z",
      "environment": {
        "MINIO_ROOT_USER": "${MINIO_USER}",
        "MINIO_ROOT_PASSWORD": "${MINIO_PASSWORD}"
      },
      "command": [
        "server",
        "--console-address",
        ":9001",
        "/data"
      ],
      "volumes": [
        "miniodata:/data"
      ],
      "mem_limit": "384m",
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-fsS",
          "http://localhost:9000/minio/health/live"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 30,
        "start_period": "20s"
      },
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "redis": {
      "image": "valkey/valkey:8-alpine",
      "environment": {
        "REDIS_PASSWORD": "${REDIS_PASSWORD}"
      },
      "command": [
        "redis-server",
        "--requirepass",
        "${REDIS_PASSWORD}",
        "--maxmemory",
        "128mb",
        "--maxmemory-policy",
        "volatile-lru"
      ],
      "volumes": [
        "redisdata:/data"
      ],
      "mem_limit": "192m",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "REDISCLI_AUTH=$$REDIS_PASSWORD redis-cli ping"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 30,
        "start_period": "20s"
      },
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "ragflow": {
      "image": "${RAGFLOW_IMAGE}",
      "platform": "${RAGFLOW_PLATFORM:-linux/amd64}",
      "env_file": [
        ".env"
      ],
      "command": [
        "--disable-datasync",
        "--workers=1",
        "--init-model-provider-tables"
      ],
      "depends_on": {
        "es01": {
          "condition": "service_healthy"
        },
        "mysql": {
          "condition": "service_healthy"
        },
        "minio": {
          "condition": "service_healthy"
        },
        "redis": {
          "condition": "service_healthy"
        }
      },
      "ports": [
        "127.0.0.1:${SVR_WEB_HTTP_PORT:-8088}:80",
        "127.0.0.1:${SVR_HTTP_PORT:-9388}:9380"
      ],
      "volumes": [
        "./logs:/ragflow/logs",
        "./upstream/service_conf.yaml.template:/ragflow/conf/service_conf.yaml.template:ro",
        "./upstream/entrypoint.sh:/ragflow/entrypoint.sh:ro"
      ],
      "extra_hosts": [
        "host.docker.internal:host-gateway"
      ],
      "mem_limit": "4g",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl -fsS http://127.0.0.1:80/ >/dev/null && curl -fsS http://127.0.0.1:9380/api/v1/system/version >/dev/null"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 30,
        "start_period": "20s"
      },
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    }
  },
  "volumes": {
    "esdata": {},
    "mysqldata": {},
    "miniodata": {},
    "redisdata": {}
  }
}
