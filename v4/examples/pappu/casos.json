  {
    "kind": "case",
    "id": "PAPPU-SWAGGER-RECORRIDO",
    "title": "Swagger conserva la operación ante acciones en distinto orden",
    "feature": "Documentación interactiva",
    "requirement": "PAPPU-SWAGGER-RECORRIDO",
    "priority": "medium",
    "level": "ui",
    "oracle_status": "inferred",
    "sources": [
      {
        "path": "backend-foundation.md",
        "locator": "Swagger de desarrollo/test"
      }
    ],
    "expected": "La operación sigue visible al cambiar la ventana, abrir o cerrar el detalle, desplazar y recargar.",
    "steps": [
      "Cargar Swagger y ejecutar todas las acciones de la ronda en orden reproducible.",
      "Comprobar la operación y errores de JavaScript después de las acciones."
    ],
    "browser_path": "/api/docs",
    "browser_walk": {
      "seed": 41,
      "rounds": 1,
      "actions": [
        {
          "id": "compacto",
          "type": "resize",
          "width": 390,
          "height": 740
        },
        {
          "id": "ancho",
          "type": "resize",
          "width": 1280,
          "height": 800
        },
        {
          "id": "detalle",
          "type": "click",
          "control": "liveness"
        },
        {
          "id": "doble-detalle",
          "type": "double_click",
          "control": "liveness"
        },
        {
          "id": "desplazar",
          "type": "scroll",
          "pixels": 700
        },
        {
          "id": "recargar",
          "type": "reload"
        }
      ]
    },
    "criteria": [
      {
        "id": "status",
        "expected": "HTTP 200 en cada navegación",
        "check": {
          "type": "status",
          "equals": 200
        }
      },
      {
        "id": "operation",
        "expected": "La operación de liveness es visible en cada punto",
        "check": {
          "type": "visible_text",
          "equals": "/api/health/live"
        }
      },
      {
        "id": "walk",
        "expected": "Se completa toda la secuencia",
        "check": {
          "type": "walk_completed"
        }
      },
      {
        "id": "js",
        "expected": "El recorrido no emite excepciones JavaScript sin capturar",
        "check": {
          "type": "no_page_errors"
        }
      }
    ]
  }
